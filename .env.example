# =============================================================================
# Sri Srinivasa Hospital — Environment Variables
# Copy to .env.local for local development
# Add the same keys in Vercel → Project → Settings → Environment Variables
# =============================================================================

# Public site URL (SEO + redirects + auth email links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Supabase
# Project Settings → API (https://supabase.com/dashboard)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here

# Server-only — NEVER expose to the browser or commit to Git
# Used in Route Handlers / Server Components for admin operations
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# -----------------------------------------------------------------------------
# Backend mode
# true  = use Supabase for appointments, auth, CMS
# false = localStorage demo mode (no Supabase required)
# unset = auto: Supabase if keys exist, else localStorage
# -----------------------------------------------------------------------------
NEXT_PUBLIC_USE_SUPABASE=true

# -----------------------------------------------------------------------------
# External Playwright runner (GitHub Actions or a network-enabled self-hosted runner)
# Never commit real values. Configure these as encrypted runner secrets.
# For GitHub Actions, set repository variable RUN_STAGING_E2E=true.
# -----------------------------------------------------------------------------
PLAYWRIGHT_BASE_URL=http://127.0.0.1:3000
PLAYWRIGHT_WEB_SERVER_COMMAND=npm run start
# Set only when the runner starts the application separately.
# PLAYWRIGHT_SKIP_WEBSERVER=1
E2E_ADMIN_EMAIL=
E2E_ADMIN_PASSWORD=
E2E_DOCTOR_EMAIL=
E2E_DOCTOR_PASSWORD=
E2E_PATIENT_EMAIL=
E2E_PATIENT_PASSWORD=
E2E_LAB_EMAIL=
E2E_LAB_PASSWORD=
E2E_RADIOLOGY_EMAIL=
E2E_RADIOLOGY_PASSWORD=
E2E_PHARMACY_EMAIL=
E2E_PHARMACY_PASSWORD=
E2E_RECEPTION_EMAIL=
E2E_RECEPTION_PASSWORD=
E2E_BILLING_EMAIL=
E2E_BILLING_PASSWORD=
E2E_FINANCE_EMAIL=
E2E_FINANCE_PASSWORD=
E2E_HR_EMAIL=
E2E_HR_PASSWORD=
E2E_MANAGER_EMAIL=
E2E_MANAGER_PASSWORD=

# When Supabase is disabled, admin demo login accepts any email + password: admin123
# When Supabase is enabled, create a user in Auth and set profiles.role = 'admin'

# -----------------------------------------------------------------------------
# Razorpay (payments)
# Dashboard → Settings → API Keys
# Webhooks: POST /api/payments/webhook
# -----------------------------------------------------------------------------
RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_secret
# Optional: dedicated webhook secret (falls back to KEY_SECRET)
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# -----------------------------------------------------------------------------
# Stripe (optional alternate gateway)
# -----------------------------------------------------------------------------
# STRIPE_SECRET_KEY=sk_test_xxxxxxxx
# STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxx
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxx

# -----------------------------------------------------------------------------
# Email — REQUIRED for appointment confirmation emails
# Create App Password: Google Account → Security → 2FA → App passwords
# Flow on booking: Save → Email → WhatsApp Meta → Log → Success
# -----------------------------------------------------------------------------
EMAIL_PROVIDER=gmail
GMAIL_USER=yourhospital@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
EMAIL_FROM=Sri Srinivasa Hospital <yourhospital@gmail.com>

# Optional paid / alternate email providers (factory auto-selects)
# RESEND_API_KEY=re_xxxxxxxx
# RESEND_FROM=Sri Srinivasa Hospital <bookings@yourdomain.com>
# SENDGRID_API_KEY=
# AWS_SES_KEY=
# HOSPITAL_INBOX=info@srisrinivasahospital.com

# -----------------------------------------------------------------------------
# WhatsApp floating chat number (public UI only)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_HOSPITAL_PHONE=8121864863
NEXT_PUBLIC_WHATSAPP_NUMBER=918121864863
NEXT_PUBLIC_HOSPITAL_WHATSAPP=918121864863

# -----------------------------------------------------------------------------
# WhatsApp Cloud API (Meta) — REQUIRED for automatic appointment WhatsApp
# Dashboard: https://developers.facebook.com/apps → WhatsApp → API Setup
#
# Error 190 = expired/invalid token. Use a PERMANENT System User token:
#   Meta Business Suite → Business Settings → System Users
#   → Generate token → permissions:
#     whatsapp_business_messaging, whatsapp_business_management
# Put ACCESS_TOKEN on ONE line (no line breaks / spaces).
# Restart `npm run dev` after changing the token.
# Template must be approved in Meta Business Manager for outbound messages.
# -----------------------------------------------------------------------------
WHATSAPP_PROVIDER=meta
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_TEMPLATE_NAME=appointment_confirmation
WHATSAPP_TEMPLATE_LANG=en_US
WHATSAPP_API_VERSION=v23.0

# -----------------------------------------------------------------------------
# SMS — Mock by default (free). Optional live providers:
# -----------------------------------------------------------------------------
# MSG91_AUTH_KEY=
# MSG91_API_KEY=
# MSG91_SENDER_ID=SSHOSP
# MSG91_TEMPLATE_ID=
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=

# Cron for appointment reminders (Bearer CRON_SECRET)
# CRON_SECRET=generate_a_long_random_string

# -----------------------------------------------------------------------------
# Analytics (optional — Google Analytics 4)
# -----------------------------------------------------------------------------
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Contact / careers inboxes (optional overrides)
# HOSPITAL_INBOX=info@srisrinivasahospital.com
# CONTACT_INBOX=info@srisrinivasahospital.com
# CAREERS_INBOX=hr@srisrinivasahospital.com
